# Public frontend
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-side app only — never NEXT_PUBLIC
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SIMULATION_GATEWAY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/simulation-gateway
LAB_SERVER_TOKEN=YOUR_APP_SCOPED_GATEWAY_TOKEN
LAB_ADMIN_PASSWORD=choose-a-strong-password
LAB_SESSION_SECRET=generate-with-openssl-rand-hex-32

# Render Workflow dispatcher — server-side only
RENDER_API_KEY=rnd_YOUR_RENDER_API_KEY
RENDER_WORKFLOW_TASK=poceada-compute/process_job

# Free Render compute fallback
RENDER_FREE_COMPUTE_URL=https://YOUR_FREE_COMPUTE.onrender.com
RENDER_FREE_COMPUTE_TOKEN=YOUR_COMPUTE_DISPATCH_TOKEN

# Python compute — worker-scoped token, never NEXT_PUBLIC
SIM_WORKER_TOKEN=YOUR_WORKER_SCOPED_GATEWAY_TOKEN
COMPUTE_DISPATCH_TOKEN=YOUR_COMPUTE_DISPATCH_TOKEN
WORKER_ID=poceada-worker-01
WORKER_NAME=POCEADA Compute 01
WORKER_POLL_SECONDS=2

# Optional local-only compatibility fallback. Do not set on Render.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# WORKER_CHUNK_ITERATIONS=1000000

# Vercel supplies VERCEL_GIT_COMMIT_SHA and Render supplies RENDER_GIT_COMMIT automatically.
# Optional fallback elsewhere:
# SIMULATION_GIT_SHA=40_HEX_GIT_COMMIT_SHA
