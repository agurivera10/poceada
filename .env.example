# Public frontend
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-side app only — never NEXT_PUBLIC
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
LAB_ADMIN_PASSWORD=choose-a-strong-password
LAB_SESSION_SECRET=generate-with-openssl-rand-hex-32
# Optional outside Vercel. Vercel supplies VERCEL_GIT_COMMIT_SHA automatically.
SIMULATION_GIT_SHA=40_HEX_GIT_COMMIT_SHA

# Python worker
WORKER_ID=poceada-worker-01
WORKER_NAME=POCEADA Compute 01
WORKER_POLL_SECONDS=2
# Optional. Preset-specific defaults are used when omitted.
# WORKER_CHUNK_ITERATIONS=1000000
